# ─────────────────────────────────────────────────────────────
# ORBIT environment configuration
# Copy to .env.local. Never commit real values.
# ─────────────────────────────────────────────────────────────

# --- Public (shipped to the browser — never put secrets here) ---

# devnet | testnet | mainnet-beta. Defaults to devnet.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# RPC endpoint used by the browser. Use a domain-restricted key if it carries one.
# Leave empty to use the cluster's public endpoint (rate limited).
NEXT_PUBLIC_SOLANA_RPC_URL=

# Mainnet is refused unless this is exactly "true". Enable only after the
# launch and trade adapters have been configured and tested on devnet.
NEXT_PUBLIC_ENABLE_MAINNET=false

# Supabase (application data: communities, updates). The anon key is public by
# design; protect tables with Row Level Security (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---

# Helius API key for indexing (DAS, enhanced transactions). Read in route handlers only.
HELIUS_API_KEY=

# Meteora Dynamic Bonding Curve pool config address. Required before the
# bonding-curve launch adapter can be enabled.
METEORA_DBC_CONFIG=

# Supabase service role key — server only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
